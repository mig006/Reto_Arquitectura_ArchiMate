  <folder name="Motivation" id="id-4f908b051e6649b2bcea2367578c8d34" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Servicio farmacéutico" id="id-b3a3b8a785014acf895aaef54b3afeaf"/>
    <element xsi:type="archimate:Stakeholder" name="Gerencia y dirección financiera" id="id-0f996783eb0a4fa2a61e9fd31259ce21"/>
    <element xsi:type="archimate:Stakeholder" name="Médicos" id="id-ef362bbf4d5645949094fdd46a7e3156"/>
    <element xsi:type="archimate:Stakeholder" name="Enfermería" id="id-a98ed3fbc6d846e693226f8b9ad43e66"/>
    <element xsi:type="archimate:Stakeholder" name="Compras" id="id-c6a8230e9a8842cab3081d429da3a726"/>
    <element xsi:type="archimate:Driver" name="Pérdida creciente por vencimientos ($190 M → $310 M en dos años)" id="id-6b33e2311048477490fc2e2312832429"/>
    <element xsi:type="archimate:Driver" name="Hallazgo de la Secretaría de Salud: vencidos en carro de paro" id="id-117b065d78924777849376fe91acefee"/>
    <element xsi:type="archimate:Driver" name="Presión de caja por cartera con las EPS" id="id-245b62b0d1eb48199203acbbbe5d7504"/>
    <element xsi:type="archimate:Driver" name="Acreditación en salud" id="id-880c1ed90acb44be8e52de9e7a00b5e5"/>
    <element xsi:type="archimate:Assessment" name="Las salidas no registran de qué lote salen (causa raíz)" id="id-cd4225ebee4a4d40a2783bb75b3a1a58"/>
    <element xsi:type="archimate:Assessment" name="Se compra con promedios y hay sobrestock (40 % de vencidos)" id="id-ad56b35b619e467aab396d0b8b1cb841"/>
    <element xsi:type="archimate:Assessment" name="Producto quieto en los servicios (25 % de vencidos)" id="id-97bb2164ae764e38bc3ba0460a6b197c"/>
    <element xsi:type="archimate:Assessment" name="Llega producto con poca vida útil (20 % de vencidos)" id="id-152ca1c49159418db5770e39a8c9be46"/>
    <element xsi:type="archimate:Assessment" name="Cambios de protocolo dejan producto sin uso (15 % de vencidos)" id="id-3bb04fc401c948748ef69ba0e1e7620e"/>
    <element xsi:type="archimate:Assessment" name="Agotados y compras urgentes" id="id-d1756cc76d054db4aa9b68deffd897d9"/>
    <element xsi:type="archimate:Goal" name="Garantizar la disponibilidad de medicamentos y reducir los vencidos a menos del 0,4 % de las compras en 12 meses" id="id-3b2117836e0d4e56b63f537920174a0c"/>
    <element xsi:type="archimate:Outcome" name="Vencidos ≤ 0,4 % de las compras" id="id-9a598731bd754e0496251701a1bd2479"/>
    <element xsi:type="archimate:Outcome" name="100 % de las salidas con lote" id="id-a6e5877ca36e41c49a46b36a3c69176a"/>
    <element xsi:type="archimate:Outcome" name="≥ 80 % de los lotes en alerta usados antes de vencer" id="id-114a7a16ce1d44948f3d5741e3a3043e"/>
    <element xsi:type="archimate:Outcome" name="Máximo 6 compras urgentes al mes" id="id-67fa7f68a3cf463f98fb00cb9d6c24f4"/>
    <element xsi:type="archimate:Principle" name="La seguridad del paciente va primero" id="id-d574b0ca99834f76ae73497a4b8a85de"/>
    <element xsi:type="archimate:Principle" name="La disponibilidad pesa más que el ahorro" id="id-561c2573cbd14f0bbba51e39cac1a560"/>
    <element xsi:type="archimate:Principle" name="Sale primero lo que vence primero" id="id-b162f4774dd140769b0064366f7bba7a"/>
    <element xsi:type="archimate:Principle" name="El sistema recomienda y la persona decide" id="id-86d8296220e94bc5b2aae9012f6b5e63"/>
    <element xsi:type="archimate:Requirement" name="Controlar el inventario por lote, ubicación y fecha de vencimiento" id="id-91b8a499b3714819b35b2145218ed89e"/>
    <element xsi:type="archimate:Requirement" name="Alertar a 6, 3 y 1 mes del vencimiento y priorizar el uso de esos lotes" id="id-92d2ef930f9d407dbbae903a85586dff"/>
    <element xsi:type="archimate:Requirement" name="Predecir la demanda programada (agenda × paquetes por cirugía) y no programada (histórico de urgencias)" id="id-686ec702ab344ea982fe74ae90899156"/>
    <element xsi:type="archimate:Requirement" name="Generar requerimientos de compra descontando lo que vencerá antes de usarse" id="id-a4e1175e6ab9427295274d6d2fa6cea3"/>
    <element xsi:type="archimate:Constraint" name="Sin personal adicional" id="id-ec0c4177fb3c4e06aefa33471ac87504"/>
    <element xsi:type="archimate:Constraint" name="Los sistemas hospitalario y contable no se pueden modificar" id="id-c2f2cad6fa124c08848b13547fa7a264"/>
  </folder>
