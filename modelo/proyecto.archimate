  <folder name="Business" id="id-fe4fcfed0e5d43b3a3d0025ca47de599" type="business">
    <element xsi:type="archimate:BusinessProcess" name="Gestión de medicamentos (E2E)" id="id-588d75efc4f647eabef800869fc7be8c">
      <documentation>Proceso E2E con dos ciclos (abastecimiento y atención) y la vigilancia de vencimientos en paralelo a ambos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Ciclo de abastecimiento" id="id-07627810a6254584a41b61d62121cba0"/>
    <element xsi:type="archimate:BusinessProcess" name="Ciclo de atención" id="id-98ba994b98804401b19e850271954d42"/>
    <element xsi:type="archimate:BusinessProcess" name="Vigilar vencimientos y retenciones de lotes" id="id-fdfb44ab2fb247069c2a79fef99d9753"/>
    <element xsi:type="archimate:BusinessProcess" name="Planear la demanda" id="id-9d249a89cb134ed3957fc6e54c3fad5d"/>
    <element xsi:type="archimate:BusinessProcess" name="Generar requerimiento de compra" id="id-330ad9cc51ef4c24871638241f7e24c6"/>
    <element xsi:type="archimate:BusinessProcess" name="Recibir (recepción técnica)" id="id-9f0c58aa9ae240369335e2d071f6d982"/>
    <element xsi:type="archimate:BusinessProcess" name="Almacenar" id="id-c0785ca47d1d4e20b33b6a0cabe4db10"/>
    <element xsi:type="archimate:BusinessProcess" name="Distribuir" id="id-43ad561b83de48cb8b18c61744163078"/>
    <element xsi:type="archimate:BusinessProcess" name="Dispensar" id="id-ae9f72d85b8c4df0aba63ecb0b26e54e"/>
    <element xsi:type="archimate:BusinessProcess" name="Gestionar devoluciones" id="id-be3c8d79d10a497e996da53f234fae69"/>
    <element xsi:type="archimate:BusinessEvent" name="Cirugías programadas en la agenda" id="id-86a80dd30166447ca8eee10d7a2affd4"/>
    <element xsi:type="archimate:BusinessEvent" name="Existencia bajo el mínimo" id="id-b02e069d05ab4e209c5edd6f69242e5b"/>
    <element xsi:type="archimate:BusinessEvent" name="Prescripción médica" id="id-4b277d9d86ee434493b342f5af221f1e"/>
    <element xsi:type="archimate:BusinessEvent" name="Lote entra en alerta de vencimiento" id="id-d8e1bd9b63be4909a8f4c42e0df2067b"/>
    <element xsi:type="archimate:BusinessEvent" name="Cirugía cancelada" id="id-f3f2cd06e18c43acbfd7e476293384ea"/>
    <element xsi:type="archimate:BusinessEvent" name="Retiro de lote por el INVIMA" id="id-e964bbb6bb23493c9a7aca50cc03396a"/>
    <element xsi:type="archimate:BusinessActor" name="Farmacia del hospital" id="id-09603e7ee9104059b28eaad169b717d0"/>
    <element xsi:type="archimate:BusinessActor" name="Médicos" id="id-3ce7919681084170804443f4f3c5463e"/>
    <element xsi:type="archimate:BusinessActor" name="Enfermería" id="id-418b271663414b57aae13416c24ceaf0"/>
    <element xsi:type="archimate:BusinessActor" name="Compras" id="id-a179cc02cbef4221810c21bdc352b585"/>
    <element xsi:type="archimate:BusinessActor" name="Proveedor" id="id-730e985a7ca045128d37e7adeada9f0f"/>
    <element xsi:type="archimate:BusinessActor" name="INVIMA" id="id-b95718c4e1b3419383e0072dba9b026b"/>
    <element xsi:type="archimate:BusinessRole" name="Químico farmacéutico" id="id-1f592a3c73d14ffe9bb8afbeb8673786"/>
    <element xsi:type="archimate:BusinessService" name="Disponibilidad de medicamentos para la atención" id="id-6d3051cc86bf4f9696b532b9da07047d">
      <documentation>Servicio que presta la gestión de medicamentos completa al flujo de valor Tratar al paciente: el medicamento correcto, disponible y vigente.</documentation>
      <property key="codigo" value="C1"/>
      <property key="capa" value="C1"/>
      <property key="alcance" value="incluido (compuesto)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Abastecimiento de medicamentos" id="id-41452f709188410488c116b592c2303d">
      <documentation>Planear, pedir, recibir y almacenar (ciclo de abastecimiento).</documentation>
      <property key="codigo" value="C2.1"/>
      <property key="capa" value="C2"/>
      <property key="alcance" value="incluido (compuesto)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Suministro de medicamentos a los servicios" id="id-4a0405e4a2644311b42df923adf0a047">
      <documentation>Distribuir, dispensar y recibir devoluciones (ciclo de atención).</documentation>
      <property key="codigo" value="C2.2"/>
      <property key="capa" value="C2"/>
      <property key="alcance" value="incluido (compuesto)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Vigilancia de vencimientos y retenciones" id="id-f936de7b209f4201b2e063c7a27ecf86">
      <documentation>Vigilancia en paralelo a los dos ciclos.</documentation>
      <property key="codigo" value="C2.3"/>
      <property key="capa" value="C2"/>
      <property key="alcance" value="incluido (compuesto)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Predicción de la demanda" id="id-8437385914d54a709c848b98e944a602">
      <documentation>Lo programado: agenda × paquetes por cirugía. Lo no programado: histórico de urgencias.</documentation>
      <property key="codigo" value="C3.1"/>
      <property key="capa" value="C3"/>
      <property key="alcance" value="incluido (compuesto)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Elaboración del requerimiento de compra" id="id-58734f1237d04f499ae45517c4a15920">
      <documentation>Farmacia dice qué y cuánto; compras dice a quién y a qué precio.</documentation>
      <property key="codigo" value="C3.2"/>
      <property key="capa" value="C3"/>
      <property key="alcance" value="incluido (compuesto)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Recepción técnica de lotes" id="id-5a79e54aa93a462a8e8b594d60b6a176">
      <documentation>Nada sale sin recepción técnica.</documentation>
      <property key="codigo" value="C3.3"/>
      <property key="capa" value="C3"/>
      <property key="alcance" value="incluido (compuesto)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Almacenamiento por lote y ubicación" id="id-1c0f5406286d40319c561e0866c42052">
      <documentation>Una farmacia con varias ubicaciones.</documentation>
      <property key="codigo" value="C3.4"/>
      <property key="capa" value="C3"/>
      <property key="alcance" value="incluido (compuesto)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Distribución interna" id="id-73df9732a70c4dbda85deec50ef1ab34">
      <documentation>Lleva los lotes a las ubicaciones y a los servicios.</documentation>
      <property key="codigo" value="C3.5"/>
      <property key="capa" value="C3"/>
      <property key="alcance" value="incluido (compuesto)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Dispensación" id="id-a5fae0fa1ac14ea88cb78eab85b63d3b">
      <documentation>La dispensación sigue en el sistema hospitalario; aquí se descuenta la salida del lote correcto.</documentation>
      <property key="codigo" value="C3.6"/>
      <property key="capa" value="C3"/>
      <property key="alcance" value="incluido (compuesto)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Devoluciones de los servicios" id="id-2de78d07f2c24aaf91ee35b6d591a69f">
      <documentation>Devolución de un servicio del hospital, distinta de la devolución al proveedor.</documentation>
      <property key="codigo" value="C3.7"/>
      <property key="capa" value="C3"/>
      <property key="alcance" value="incluido (compuesto)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Control de vencimientos" id="id-c16dceef11b3433c92dedf7f86b0ce25">
      <documentation>Alertas a 6, 3 y 1 mes, priorización, canje y baja.</documentation>
      <property key="codigo" value="C3.8"/>
      <property key="capa" value="C3"/>
      <property key="alcance" value="incluido (compuesto)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Retención de lotes" id="id-d5aa15901bbb40a283ecf9b4490fd224">
      <documentation>Ante un retiro del INVIMA solo se retiene el lote en todas sus ubicaciones.</documentation>
      <property key="codigo" value="C3.9"/>
      <property key="capa" value="C3"/>
      <property key="alcance" value="incluido (compuesto)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Calcular la demanda programada" id="id-3ba4e1ec542d4a929cb7bae24249b7a1">
      <documentation>Agenda quirúrgica × paquetes por cirugía.</documentation>
      <property key="codigo" value="S01"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.1"/>
      <property key="ejecuta" value="Automático; revisa el químico farmacéutico"/>
      <property key="realiza" value="R3"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Calcular la demanda no programada" id="id-db934d4640fe474ca0e5cd5eae2546aa">
      <documentation>Promedio del histórico de 5 años de consumos de urgencias.</documentation>
      <property key="codigo" value="S02"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.1"/>
      <property key="ejecuta" value="Automático; revisa el químico farmacéutico"/>
      <property key="realiza" value="R3"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Aprobar la predicción de la demanda" id="id-28adeae9576740d28325af623d4154b1">
      <documentation>El sistema recomienda y la persona decide; quien elabora no aprueba.</documentation>
      <property key="codigo" value="S03"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.1"/>
      <property key="ejecuta" value="Químico farmacéutico"/>
      <property key="realiza" value="R3"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Mantener los paquetes por cirugía" id="id-87b0acf1d89649b0aed4a31cdac96f93">
      <documentation>Insumo de S01; se cargan una vez desde el Excel actual y los mantiene farmacia.</documentation>
      <property key="codigo" value="S04"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.1"/>
      <property key="ejecuta" value="Químico farmacéutico"/>
      <property key="realiza" value="R3"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Calcular el requerimiento neto" id="id-1f080ccf5cc746d1ac23d36dad740250">
      <documentation>Consumo × tiempo a cubrir − existencias − lo que viene en camino − lo que vencerá antes de usarse; frena la compra de lo que está en alerta.</documentation>
      <property key="codigo" value="S05"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.2"/>
      <property key="ejecuta" value="Automático; revisa el químico farmacéutico"/>
      <property key="realiza" value="R4"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Aprobar el requerimiento de compra" id="id-054777cf05e34812878202e011895ecd">
      <documentation>Única regla de aprobación: quien elabora no aprueba.</documentation>
      <property key="codigo" value="S06"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.2"/>
      <property key="ejecuta" value="Químico farmacéutico"/>
      <property key="realiza" value="R4"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Registrar la recepción técnica del lote" id="id-7a7b437612e446e0a8896662a1fa83e5">
      <documentation>El lote y el vencimiento se registran al recibir, aunque el código de barras no los traiga; el lote entra en cuarentena.</documentation>
      <property key="codigo" value="S07"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.3"/>
      <property key="ejecuta" value="Regente de farmacia"/>
      <property key="realiza" value="R1"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Aprobar o rechazar el lote en cuarentena" id="id-7b24f466b5604f86a4bdd50fbf9f862b">
      <documentation>Nada sale sin recepción técnica.</documentation>
      <property key="codigo" value="S08"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.3"/>
      <property key="ejecuta" value="Regente de farmacia distinto del que registró"/>
      <property key="realiza" value="R1"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Consultar existencias por lote, ubicación y vencimiento" id="id-0403cd0a0cd14e3b95de64873785ecf5">
      <documentation>Es lo que más pide el experto: qué lote hay, cuánto, dónde y con qué vencimiento.</documentation>
      <property key="codigo" value="S09"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.4"/>
      <property key="ejecuta" value="Químico farmacéutico y regente de farmacia"/>
      <property key="realiza" value="R1"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Ajustar existencias por conteo" id="id-0b421d857783462199720bc851c2ac14">
      <documentation>Decisión del equipo: hace falta para que el lote cuadre con el conteo físico.</documentation>
      <property key="codigo" value="S11"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.4"/>
      <property key="ejecuta" value="Regente propone, químico aprueba"/>
      <property key="realiza" value="R1"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Trasladar un lote entre ubicaciones" id="id-276693823b1146efb13c0b28bd1c522d">
      <documentation>Una farmacia con varias ubicaciones; trasladar es una acción ante la alerta.</documentation>
      <property key="codigo" value="S10"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.5"/>
      <property key="ejecuta" value="Regente de farmacia; quien recibe confirma"/>
      <property key="realiza" value="R1, R2"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Apartar y liberar un lote para una cirugía" id="id-79d492513437404aa80e145e5b4f39e6">
      <documentation>Acción ante la alerta; se libera si la cirugía se cancela.</documentation>
      <property key="codigo" value="S12"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.5"/>
      <property key="ejecuta" value="Regente de farmacia"/>
      <property key="realiza" value="R2"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Descontar la salida del lote que vence primero" id="id-ef7ea0e5d8654c048b29af1a8a482573">
      <documentation>La dispensación sigue en el sistema hospitalario; aquí se recibe la salida y se descuenta del lote correcto. Logra el 100 % de salidas con lote.</documentation>
      <property key="codigo" value="S13"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.6"/>
      <property key="ejecuta" value="Automático"/>
      <property key="realiza" value="R1"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Reingresar una devolución de un servicio" id="id-91e7513924454f4ab1d25b9b829982c6">
      <documentation>Devolución de un servicio del hospital, distinta de la devolución al proveedor.</documentation>
      <property key="codigo" value="S14"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.7"/>
      <property key="ejecuta" value="Regente de farmacia"/>
      <property key="realiza" value="R1"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Generar alertas de vencimiento a 6, 3 y 1 mes" id="id-bc6e3182c942459f8edc6794fe6b7b80">
      <documentation>Alertas fijas. La alerta no cambia el estado: el lote sigue disponible con prioridad. El día que llega su fecha de vencimiento, el lote pasa a vencido.</documentation>
      <property key="codigo" value="S15"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.8"/>
      <property key="ejecuta" value="Automático"/>
      <property key="realiza" value="R2"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Priorizar la salida de los lotes en alerta" id="id-942e0fd4a3614569a7e5509df7ff3787">
      <documentation>Sale primero lo que vence primero; próximo a vencer es una alerta, no un estado.</documentation>
      <property key="codigo" value="S16"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.8"/>
      <property key="ejecuta" value="Químico farmacéutico"/>
      <property key="realiza" value="R2"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Solicitar canje al proveedor" id="id-1962114fe0404043aa45cc83e3309009">
      <documentation>Solo la solicitud; la alerta de 6 meses existe porque el proveedor la pide para aceptar el canje.</documentation>
      <property key="codigo" value="S18"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.8"/>
      <property key="ejecuta" value="Químico farmacéutico"/>
      <property key="realiza" value="R2"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Dar de baja un lote con acta aprobada" id="id-e8258da1f16c49f88d74785e56b1457e">
      <documentation>Baja con acta aprobada; alimenta a contabilidad.</documentation>
      <property key="codigo" value="S19"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.8"/>
      <property key="ejecuta" value="Regente elabora el acta, químico aprueba"/>
      <property key="realiza" value="R1"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Retener un lote en todas sus ubicaciones" id="id-3ca3f43e75c34f71b2d575954f3020bd">
      <documentation>Ante un retiro del INVIMA solo se retiene el lote.</documentation>
      <property key="codigo" value="S17"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.9"/>
      <property key="ejecuta" value="Regente retiene, químico confirma"/>
      <property key="realiza" value="R1"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Ajustar la predicción por estacionalidad, censo de camas, anestesia y cirujano" id="id-96910baa2df448d7a016949f1800e444">
      <documentation>Simplificado: lo programado sale de los paquetes y lo no programado del histórico; censo de camas descartado.</documentation>
      <property key="codigo" value="X01"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="excluido"/>
      <property key="padre" value="C3.1"/>
      <property key="lo_hace" value="Nadie (mejora futura)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Emitir la orden de compra y negociar con el proveedor" id="id-064a3a82026843c2b735a124aca42616">
      <documentation>Farmacia dice qué y cuánto; compras dice a quién y a qué precio.</documentation>
      <property key="codigo" value="X02"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="excluido"/>
      <property key="padre" value="C3.2"/>
      <property key="lo_hace" value="Compras"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Aprobar por niveles según monto, tipo y horario" id="id-a1967614278c4e43b27cc699b9af58ea">
      <documentation>Una sola regla de aprobación: quien elabora no aprueba.</documentation>
      <property key="codigo" value="X03"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="excluido"/>
      <property key="padre" value="C3.2"/>
      <property key="lo_hace" value="No se adopta"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Hacer la recepción administrativa contra orden y factura" id="id-4fbd89df322f43929112d8cbba9c33ca">
      <documentation>La hace almacén o compras.</documentation>
      <property key="codigo" value="X04"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="excluido"/>
      <property key="padre" value="C3.3"/>
      <property key="lo_hace" value="Almacén / compras"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Monitorear temperatura y cadena de frío" id="id-f12126f432784508a7d1d0801a34884e">
      <documentation>Descartado; una falla de nevera solo entra como causa para retener (S17).</documentation>
      <property key="codigo" value="X05"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="excluido"/>
      <property key="padre" value="C3.4"/>
      <property key="lo_hace" value="Control de calidad del almacenamiento"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Custodiar y reportar medicamentos de control especial" id="id-fb13cb2f542443a6a24a5fbf1e465544">
      <documentation>Proceso regulado con libro propio e informe al Fondo Rotatorio.</documentation>
      <property key="codigo" value="X06"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="excluido"/>
      <property key="padre" value="C3.4"/>
      <property key="lo_hace" value="Farmacia, con su propio registro"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Reempacar en dosis unitaria" id="id-f7dac61c3b2c4e72b430b049dffaeea5">
      <documentation>No cambia el control por lote.</documentation>
      <property key="codigo" value="X07"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="excluido"/>
      <property key="padre" value="C3.6"/>
      <property key="lo_hace" value="Farmacia (operación técnica)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Validar la prescripción y dispensar" id="id-55567148e1ff4c1ea70457a56ea2e8a7">
      <documentation>La dispensación sigue en el sistema hospitalario, que no se puede modificar.</documentation>
      <property key="codigo" value="X08"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="excluido"/>
      <property key="padre" value="C3.6"/>
      <property key="lo_hace" value="Sistema hospitalario"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Administrar el medicamento al paciente" id="id-cc34999365bc42228190ab1c0034677a">
      <documentation>Administrar no es dispensar.</documentation>
      <property key="codigo" value="X09"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="excluido"/>
      <property key="padre" value="C3.6"/>
      <property key="lo_hace" value="Enfermería"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Prestar medicamentos a otras clínicas" id="id-c39f113110ce4fbdb966b0c1f6f4fe7b">
      <documentation>Informal y ocasional, sin impacto en la meta.</documentation>
      <property key="codigo" value="X10"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="excluido"/>
      <property key="padre" value="C3.7"/>
      <property key="lo_hace" value="Farmacia (informal)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Negociar el canje y registrar la nota crédito" id="id-008d1c9c5c654690abe6767cccd5f820">
      <documentation>Del canje solo se modela la solicitud.</documentation>
      <property key="codigo" value="X11"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="excluido"/>
      <property key="padre" value="C3.8"/>
      <property key="lo_hace" value="Compras y contabilidad"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Destruir lo vencido y gestionar residuos" id="id-46fcc063ed1a4337802c5822affde743">
      <documentation>Ocurre después de la baja.</documentation>
      <property key="codigo" value="X12"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="excluido"/>
      <property key="padre" value="C3.8"/>
      <property key="lo_hace" value="Gestión ambiental"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Consultar los indicadores de vencimiento" id="id-50c2eda30c6848a8ada1528a6c145d6a">
      <documentation>Calcula los indicadores que solo esta aplicación puede medir, porque es la única que conoce el lote: % de salidas con lote, % de lo alertado usado antes de vencer y valor dado de baja por vencimiento. El % de vencidos sobre compras lo completa financiera con el valor de compras, y las compras urgentes las reporta compras. Antes estaba excluido (X14); se incluyó para medir los resultados de la V1 (decisión del equipo).</documentation>
      <property key="codigo" value="S20"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="incluido"/>
      <property key="padre" value="C3.8"/>
      <property key="ejecuta" value="Automático; lo consultan el químico farmacéutico y la gerencia"/>
      <property key="realiza" value="Resultados de la V1 (medición)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Rastrear pacientes y reportar farmacovigilancia al INVIMA" id="id-4b29534353da44ca8578b2ffd7b5b1e8">
      <documentation>Ante un retiro solo se retiene el lote; el resto lo hace farmacovigilancia en su propio aplicativo.</documentation>
      <property key="codigo" value="X13"/>
      <property key="capa" value="C4"/>
      <property key="alcance" value="excluido"/>
      <property key="padre" value="C3.9"/>
      <property key="lo_hace" value="Calidad (farmacovigilancia)"/>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Regente de farmacia" id="id-e422142866df414eab4aedaf5da7cdbc">
      <documentation>Recibe y registra la recepción técnica, aprueba la cuarentena, traslada, aparta, retiene y elabora las actas. Rol nuevo de la Fase 2, decisión del equipo.</documentation>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Gestión de la demanda" id="id-f426aac5eb0f45e19a71b621557e8e6a">
      <documentation>Agrupa el comportamiento de predecir la demanda programada y no programada y de mantener sus insumos. Realiza la capacidad Planeación de la demanda de medicamentos.</documentation>
      <property key="codigo" value="F1"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Gestión de requerimientos de compra" id="id-4f7e3b4b8bc841edbffd68366009aa94">
      <documentation>Agrupa el cálculo y la aprobación del requerimiento de compra. Farmacia dice qué y cuánto.</documentation>
      <property key="codigo" value="F2"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Control de existencias por lote" id="id-dd9724d6d0eb4123a2056c5f67f8d992">
      <documentation>Agrupa todo movimiento y consulta de existencias por lote y ubicación: recepción, cuarentena, traslado, ajuste, apartado, salida y devolución.</documentation>
      <property key="codigo" value="F3"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="Control de la vida útil de los lotes" id="id-cad2cb2a143b4eada5a0a87958012403">
      <documentation>Agrupa las alertas de vencimiento, la priorización, el canje, la baja, la retención de lotes y los indicadores de vencimiento.</documentation>
      <property key="codigo" value="F4"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Contabilidad" id="id-b8229ddec7894a07b20708afe654fed9">
      <documentation>Área que registra las bajas por vencimiento en el sistema contable. Actor nuevo de la Fase 2, decisión del equipo.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Programación quirúrgica" id="id-8c19c6cd9f3a453bbe4b9f672baebb87">
      <documentation>Proceso interno. Publica las cirugías programadas, canceladas y reprogramadas. Lo presta el equipo quirúrgico (supuesto del equipo).</documentation>
      <property key="codigo" value="E1"/>
      <property key="capa" value="C5"/>
      <property key="alcance" value="externo"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Registro de dispensación y consumos" id="id-55a7e4d6ad064c038e977acf99b2d6f1">
      <documentation>Sistema hospitalario, que no se puede modificar. Incluye historia clínica, prescripción y consumos de urgencias.</documentation>
      <property key="codigo" value="E2"/>
      <property key="capa" value="C5"/>
      <property key="alcance" value="externo"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Gestión de compras" id="id-6ee01e92c480427788eefb0dda4040d8">
      <documentation>Proceso interno. Emite las órdenes de compra y negocia con el proveedor.</documentation>
      <property key="codigo" value="E3"/>
      <property key="capa" value="C5"/>
      <property key="alcance" value="externo"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Suministro de medicamentos" id="id-eeff3b6db6fe436697edeb8237135ca2">
      <documentation>Proveedor externo. Entrega los pedidos con lote y vencimiento y atiende el canje.</documentation>
      <property key="codigo" value="E4"/>
      <property key="capa" value="C5"/>
      <property key="alcance" value="externo"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Registro contable" id="id-73bdae0f08e044f9956b941d338254ac">
      <documentation>Sistema contable, que no se puede modificar. Registra las bajas por vencimiento.</documentation>
      <property key="codigo" value="E5"/>
      <property key="capa" value="C5"/>
      <property key="alcance" value="externo"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Alertas sanitarias y retiros de lotes" id="id-08581b6478544a6281f16f80879c07f3">
      <documentation>Ente regulador. Publica alertas sanitarias y retiros de lotes.</documentation>
      <property key="codigo" value="E6"/>
      <property key="capa" value="C5"/>
      <property key="alcance" value="externo"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Recibir la agenda quirúrgica" id="id-9d032799d1284a8dabe56d64263d4e66">
      <documentation>Traduce las cirugías de la agenda (código de procedimiento) a cirugías programadas con su paquete.</documentation>
      <property key="codigo" value="A1"/>
      <property key="capa" value="C5"/>
      <property key="alcance" value="incluido"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Recibir los movimientos del sistema hospitalario" id="id-f94018f9f6734584bf14c9ae9c4a226a">
      <documentation>Traduce salidas dispensadas, devoluciones y consumos de urgencias del sistema hospitalario a movimientos de inventario.</documentation>
      <property key="codigo" value="A2"/>
      <property key="capa" value="C5"/>
      <property key="alcance" value="incluido"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Enviar el requerimiento y consultar lo que viene en camino" id="id-97d49c8f9aa1426cb6212d40e87e3064">
      <documentation>Entrega a compras el requerimiento aprobado y consulta las órdenes de compra en camino.</documentation>
      <property key="codigo" value="A3"/>
      <property key="capa" value="C5"/>
      <property key="alcance" value="incluido"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Reportar las bajas a contabilidad" id="id-87015631ca024bc9a1f6e985c5e5c974">
      <documentation>Envía a contabilidad las bajas por vencimiento con acta aprobada y su valor.</documentation>
      <property key="codigo" value="A5"/>
      <property key="capa" value="C5"/>
      <property key="alcance" value="incluido"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Recibir alertas y retiros del INVIMA" id="id-0e6ffff1cf1148438c9212431dc3a0d9">
      <documentation>Registra las alertas sanitarias y los lotes retirados; el canal puede ser manual (el químico consulta la página del INVIMA).</documentation>
      <property key="codigo" value="A6"/>
      <property key="capa" value="C5"/>
      <property key="alcance" value="incluido"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Intercambiar información con el proveedor" id="id-8b5c1d5e8e0e43378eb2b3c5a3e41269">
      <documentation>Recibe el lote y el vencimiento en la recepción y envía la solicitud de canje.</documentation>
      <property key="codigo" value="A4"/>
      <property key="capa" value="C5"/>
      <property key="alcance" value="incluido"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="Homologar el código del medicamento" id="id-beff4fc415094dfca3d2a639039a53da">
      <documentation>Traductor común: convierte el código de cada sistema externo y el código del empaque al código interno del medicamento. Si no hay equivalencia, rechaza y avisa.</documentation>
      <property key="codigo" value="A7"/>
      <property key="capa" value="C5"/>
      <property key="alcance" value="incluido"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Cirugía programada" id="id-bd07d0f496874ac5ba438adc9328250e">
      <documentation>Cirugía de la agenda quirúrgica con fecha y tipo; viene de la programación quirúrgica (A1).</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Paquete por cirugía" id="id-a73797509ce84b4d8b1a47746cbba5fe">
      <documentation>Lista estándar de medicamentos y cantidades por tipo de cirugía (~180 paquetes).</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Predicción de la demanda" id="id-d6bc8b84953a4e0f9aa2a07af2113bc3">
      <documentation>Demanda programada más no programada por medicamento y periodo; la aprueba el químico farmacéutico.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Requerimiento de compra" id="id-242d953d79d247f1af38239571e0f2dd">
      <documentation>Lo que farmacia necesita: qué y cuánto. No es una orden de compra, que la emite compras.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Orden de compra en camino" id="id-6b9e57da05174c06b2c1afd858d10919">
      <documentation>Orden emitida por compras que todavía no llega; se consulta para no pedir dos veces.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Medicamento" id="id-ab41869bddaa476791f05f98b8b8dcb0">
      <documentation>Producto del catálogo, identificado por un código interno al que se homologan los códigos externos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Acta de recepción técnica" id="id-5a43eafaf3974f15a5c875913c4d8ff8">
      <documentation>Registro de la inspección del lote al recibirlo; lo deja en cuarentena hasta aprobarlo.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Lote" id="id-86fd4543078a431684546b6938af52f7">
      <documentation>Unidad de control: medicamento, número de lote, fecha de vencimiento, cantidad por ubicación y estado. Estados: cuarentena, disponible, apartado, retenido, vencido, dado de baja. 'Próximo a vencer' y 'rechazado' no son estados: el primero es una alerta y el segundo es un motivo de retención.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Ubicación" id="id-95911d2ae1e4453c898ace3cb8f3e785">
      <documentation>Lugar físico de la farmacia donde hay existencias (central, satélite, stock de piso, carro de paro).</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Movimiento de inventario" id="id-8579573301654f9c9c4a41a3e9589b60">
      <documentation>Entrada o salida de existencias de un lote: salida, devolución, traslado o ajuste.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Alerta de vencimiento" id="id-199bf854b70a458e99f703755e11fa27">
      <documentation>Aviso a 6, 3 o 1 mes del vencimiento. No es un estado del lote: el lote sigue disponible con prioridad de salida.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Alerta sanitaria del INVIMA" id="id-b16a42727d324496873e1275d9b021f0">
      <documentation>Alerta o retiro de un lote publicado por el INVIMA.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Solicitud de canje" id="id-f4b056f4895e4c559ee76bef50896bf8">
      <documentation>Pedido al proveedor de cambiar un lote próximo a vencer; la negociación la hace compras.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Acta de baja" id="id-600788f194204df3b28346abf83f5e49">
      <documentation>Documento aprobado que autoriza dar de baja un lote vencido o deteriorado.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S01 - Calcular la demanda programada" id="id-22e5e2d881bc4fbe87fada3a714758a4">
      <documentation>Contrato del servicio S01 (Calcular la demanda programada), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="S03 Aprobar la predicción (químico farmacéutico)"/>
      <property key="proveedor" value="Gestión de la demanda"/>
      <property key="entrada" value="Cirugías programadas (A1); paquetes por cirugía"/>
      <property key="salida" value="Demanda programada por medicamento y periodo"/>
      <property key="precondiciones" value="Agenda recibida; cada tipo de cirugía tiene paquete vigente"/>
      <property key="reglas" value="Demanda = cirugías programadas × cantidades del paquete. Las cirugías canceladas no cuentan. El sistema recomienda, no decide"/>
      <property key="disparador" value="Evento Cirugías programadas en la agenda, o cambio de la agenda"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S02 - Calcular la demanda no programada" id="id-79b3013c476a4db3b42c7cd4548267b3">
      <documentation>Contrato del servicio S02 (Calcular la demanda no programada), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="S03 Aprobar la predicción (químico farmacéutico)"/>
      <property key="proveedor" value="Gestión de la demanda"/>
      <property key="entrada" value="Consumos de urgencias de los últimos 5 años (A2)"/>
      <property key="salida" value="Demanda no programada estimada por medicamento y periodo"/>
      <property key="precondiciones" value="Histórico de consumos disponible"/>
      <property key="reglas" value="Promedio del histórico, sin estacionalidad ni censo de camas (simplificación del equipo)"/>
      <property key="disparador" value="Ciclo periódico de planeación"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S03 - Aprobar la predicción de la demanda" id="id-ef5208645929430cb165937cf64ddc4c">
      <documentation>Contrato del servicio S03 (Aprobar la predicción de la demanda), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="S05 Calcular el requerimiento neto"/>
      <property key="proveedor" value="Gestión de la demanda (químico farmacéutico)"/>
      <property key="entrada" value="Demanda programada y no programada calculadas"/>
      <property key="salida" value="Predicción de la demanda aprobada"/>
      <property key="precondiciones" value="Predicción calculada (S01 y S02)"/>
      <property key="reglas" value="Quien elabora no aprueba. El químico puede ajustar antes de aprobar. Sin predicción aprobada no se calcula el requerimiento"/>
      <property key="disparador" value="Predicción lista para revisión"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S04 - Mantener los paquetes por cirugía" id="id-dd85fd741c594fc4aad06a8d0e985e06">
      <documentation>Contrato del servicio S04 (Mantener los paquetes por cirugía), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="S01 Calcular la demanda programada"/>
      <property key="proveedor" value="Gestión de la demanda (químico farmacéutico)"/>
      <property key="entrada" value="Tipo de cirugía, medicamentos y cantidades"/>
      <property key="salida" value="Paquete por cirugía vigente"/>
      <property key="precondiciones" value="Carga inicial desde el Excel actual"/>
      <property key="reglas" value="Un paquete vigente por tipo de cirugía; un cambio de protocolo crea una versión nueva del paquete"/>
      <property key="disparador" value="Cambio de protocolo o de paquete"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S05 - Calcular el requerimiento neto" id="id-271a23bb64884e81a0c35a2d1b8d0ab3">
      <documentation>Contrato del servicio S05 (Calcular el requerimiento neto), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="S06 Aprobar el requerimiento de compra"/>
      <property key="proveedor" value="Gestión de requerimientos de compra"/>
      <property key="entrada" value="Predicción aprobada; existencias por lote; órdenes en camino (A3); lotes que vencerán antes de usarse"/>
      <property key="salida" value="Requerimiento de compra en borrador"/>
      <property key="precondiciones" value="Predicción aprobada (S03)"/>
      <property key="reglas" value="Consumo × tiempo a cubrir − existencias − en camino − lo que vencerá antes de usarse. No pide lo que está en alerta y todavía puede usarse. Consumo = lo dispensado, no lo despachado a las satélites (lenguaje ubicuo, V7)"/>
      <property key="disparador" value="Evento Existencia bajo el mínimo, o ciclo de compra"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S06 - Aprobar el requerimiento de compra" id="id-4a7a55a3b7a94fe080ac597ddf2b7238">
      <documentation>Contrato del servicio S06 (Aprobar el requerimiento de compra), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="Compras (vía A3)"/>
      <property key="proveedor" value="Gestión de requerimientos de compra (químico farmacéutico)"/>
      <property key="entrada" value="Requerimiento en borrador; usuario aprobador"/>
      <property key="salida" value="Requerimiento de compra aprobado, enviado por A3"/>
      <property key="precondiciones" value="Existe un requerimiento en borrador"/>
      <property key="reglas" value="Quien elabora no aprueba; una sola regla de aprobación. Farmacia dice qué y cuánto; no se emite orden de compra"/>
      <property key="disparador" value="Requerimiento en borrador listo"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S07 - Registrar la recepción técnica del lote" id="id-e1d5e810ce284fc4b46432090166c808">
      <documentation>Contrato del servicio S07 (Registrar la recepción técnica del lote), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="S08 Aprobar o rechazar el lote"/>
      <property key="proveedor" value="Control de existencias por lote (regente de farmacia)"/>
      <property key="entrada" value="Medicamento (código del empaque vía A7); lote; vencimiento; cantidad; ubicación; remisión (A4)"/>
      <property key="salida" value="Lote en cuarentena y acta de recepción técnica"/>
      <property key="precondiciones" value="El medicamento existe en el catálogo"/>
      <property key="reglas" value="Lote y vencimiento son obligatorios aunque el código de barras no los traiga. Todo lote nuevo entra en cuarentena"/>
      <property key="disparador" value="Llegada de un pedido del proveedor"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S08 - Aprobar o rechazar el lote en cuarentena" id="id-6cc287b85419408b90ac4ad82c481ce8">
      <documentation>Contrato del servicio S08 (Aprobar o rechazar el lote en cuarentena), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="Servicios de inventario (S09 a S13)"/>
      <property key="proveedor" value="Control de existencias por lote (regente de farmacia)"/>
      <property key="entrada" value="Lote en cuarentena; resultado de la inspección"/>
      <property key="salida" value="Lote disponible, o retenido si se rechaza"/>
      <property key="precondiciones" value="El lote está en cuarentena"/>
      <property key="reglas" value="Nada sale sin recepción técnica. Quien registra la recepción (S07) no la aprueba. Un lote rechazado pasa a retenido con motivo 'rechazado en recepción'; la devolución al proveedor la gestiona compras"/>
      <property key="disparador" value="Inspección terminada"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S09 - Consultar existencias por lote, ubicación y vencimiento" id="id-4d4ec897cf5c4d44b1adf4875044804f">
      <documentation>Contrato del servicio S09 (Consultar existencias por lote, ubicación y vencimiento), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="Químico farmacéutico, regente de farmacia, Enfermería"/>
      <property key="proveedor" value="Control de existencias por lote"/>
      <property key="entrada" value="Filtros: medicamento, lote, ubicación"/>
      <property key="salida" value="Existencias por lote, ubicación, vencimiento y estado, con sus alertas vigentes"/>
      <property key="precondiciones" value="Ninguna"/>
      <property key="reglas" value="Solo lectura. Próximo a vencer se muestra como alerta, no como estado"/>
      <property key="disparador" value="Consulta del usuario"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S10 - Trasladar un lote entre ubicaciones" id="id-5f2f7ae8c3fa4cb2ab56b162dc329d2e">
      <documentation>Contrato del servicio S10 (Trasladar un lote entre ubicaciones), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="Ubicación de destino (servicio o satélite)"/>
      <property key="proveedor" value="Control de existencias por lote (regente de farmacia)"/>
      <property key="entrada" value="Lote; cantidad; ubicación de origen y de destino"/>
      <property key="salida" value="Movimiento de traslado confirmado"/>
      <property key="precondiciones" value="Lote disponible con existencia en el origen"/>
      <property key="reglas" value="Quien recibe confirma. Las existencias nunca quedan negativas. No se trasladan lotes retenidos ni vencidos"/>
      <property key="disparador" value="Acción ante una alerta, o reposición de una ubicación"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S11 - Ajustar existencias por conteo" id="id-2cf8c64fee8f4d349337bb0bf0c81045">
      <documentation>Contrato del servicio S11 (Ajustar existencias por conteo), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="Servicios de inventario"/>
      <property key="proveedor" value="Control de existencias por lote"/>
      <property key="entrada" value="Lote; ubicación; cantidad contada; motivo"/>
      <property key="salida" value="Movimiento de ajuste aprobado"/>
      <property key="precondiciones" value="Conteo físico registrado"/>
      <property key="reglas" value="El regente propone y el químico aprueba; quien propone no aprueba. Queda registrado el motivo"/>
      <property key="disparador" value="Conteo físico con diferencia"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S12 - Apartar y liberar un lote para una cirugía" id="id-c771ad97e26643dbbefdb6f5028af451">
      <documentation>Contrato del servicio S12 (Apartar y liberar un lote para una cirugía), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="Cirugía programada"/>
      <property key="proveedor" value="Control de existencias por lote (regente de farmacia)"/>
      <property key="entrada" value="Lote; cantidad; cirugía programada (A1)"/>
      <property key="salida" value="Lote apartado o liberado"/>
      <property key="precondiciones" value="Lote disponible; la cirugía está programada"/>
      <property key="reglas" value="Un lote apartado solo sale para la cirugía para la que se apartó (S13). Se libera si la cirugía se cancela. Se prefiere apartar lotes en alerta"/>
      <property key="disparador" value="Cirugía programada o cancelada (A1)"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S13 - Descontar la salida del lote que vence primero" id="id-3491cdbccd40457686582b1304bccccc">
      <documentation>Contrato del servicio S13 (Descontar la salida del lote que vence primero), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="Inventario; resultado 100 % de las salidas con lote"/>
      <property key="proveedor" value="Control de existencias por lote (automático)"/>
      <property key="entrada" value="Salida dispensada: código externo, cantidad, ubicación, fecha y, si aplica, la cirugía (A2)"/>
      <property key="salida" value="Movimiento de salida con lote"/>
      <property key="precondiciones" value="Hay existencia disponible en la ubicación"/>
      <property key="reglas" value="Sale el lote que vence primero. Nunca sale un lote vencido, retenido o en cuarentena. Un lote apartado solo sale para la cirugía para la que se apartó (S12). Las existencias nunca quedan negativas"/>
      <property key="disparador" value="Movimiento recibido del sistema hospitalario"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S14 - Reingresar una devolución de un servicio" id="id-f259a1d715cb472a9d52de49ee54d340">
      <documentation>Contrato del servicio S14 (Reingresar una devolución de un servicio), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="Servicios de inventario"/>
      <property key="proveedor" value="Control de existencias por lote (regente de farmacia)"/>
      <property key="entrada" value="Devolución del servicio: medicamento, lote, cantidad y ubicación (A2)"/>
      <property key="salida" value="Movimiento de devolución; lote disponible, vencido o retenido según su condición"/>
      <property key="precondiciones" value="Existe la salida original"/>
      <property key="reglas" value="Una devolución de un servicio no es una devolución al proveedor. Vuelve al mismo lote. Si el lote está vencido vuelve como vencido; si llega deteriorado se retiene (S17) para decidir la baja (S19)"/>
      <property key="disparador" value="Devolución registrada en el sistema hospitalario"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S15 - Generar alertas de vencimiento a 6, 3 y 1 mes" id="id-c568b5d6c6e24dbb9f6677307080525a">
      <documentation>Contrato del servicio S15 (Generar alertas de vencimiento a 6, 3 y 1 mes), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="S16 Priorizar la salida; S18 Solicitar canje"/>
      <property key="proveedor" value="Control de la vida útil de los lotes (automático)"/>
      <property key="entrada" value="Fecha de corte; lotes disponibles y apartados"/>
      <property key="salida" value="Alertas de vencimiento a 6, 3 y 1 mes; lotes que llegaron a su fecha marcados como vencidos"/>
      <property key="precondiciones" value="Ninguna"/>
      <property key="reglas" value="Alertas fijas a 6, 3 y 1 mes. La alerta no cambia el estado: el lote sigue disponible con prioridad de salida. El día que llega su fecha de vencimiento el lote pasa a vencido y queda bloqueado para salir"/>
      <property key="disparador" value="Corte diario"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S16 - Priorizar la salida de los lotes en alerta" id="id-95e68041a3b84ec1b6eb700d60d21277">
      <documentation>Contrato del servicio S16 (Priorizar la salida de los lotes en alerta), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="Distribución, dispensación y compras"/>
      <property key="proveedor" value="Control de la vida útil de los lotes (químico farmacéutico)"/>
      <property key="entrada" value="Alertas vigentes; demanda próxima"/>
      <property key="salida" value="Lotes priorizados y acción elegida: trasladar, apartar, frenar la compra o pedir canje"/>
      <property key="precondiciones" value="Hay una alerta vigente"/>
      <property key="reglas" value="Sale primero lo que vence primero. El sistema recomienda y el químico decide"/>
      <property key="disparador" value="Evento Lote entra en alerta de vencimiento"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S17 - Retener un lote en todas sus ubicaciones" id="id-32a2db5c2d9842f5ae7f738eae6d6087">
      <documentation>Contrato del servicio S17 (Retener un lote en todas sus ubicaciones), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="Servicios de inventario (bloquea las salidas)"/>
      <property key="proveedor" value="Control de la vida útil de los lotes (regente retiene, químico confirma)"/>
      <property key="entrada" value="Lote y motivo: retiro del INVIMA (A6), falla de la cadena de frío, rechazo en recepción (S08) o deterioro en una devolución (S14)"/>
      <property key="salida" value="Lote retenido en todas sus ubicaciones"/>
      <property key="precondiciones" value="El lote existe"/>
      <property key="reglas" value="Nunca sale un lote retenido. Solo se retiene; el rastreo de pacientes lo hace farmacovigilancia"/>
      <property key="disparador" value="Evento Retiro de lote por el INVIMA"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S18 - Solicitar canje al proveedor" id="id-420c8585b75a43148b1f202fbce5b810">
      <documentation>Contrato del servicio S18 (Solicitar canje al proveedor), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="Proveedor (vía A4)"/>
      <property key="proveedor" value="Control de la vida útil de los lotes (químico farmacéutico)"/>
      <property key="entrada" value="Lote con alerta de 6 meses; proveedor"/>
      <property key="salida" value="Solicitud de canje enviada por A4"/>
      <property key="precondiciones" value="Alerta de 6 meses vigente"/>
      <property key="reglas" value="Solo se registra la solicitud; la negociación y la nota crédito las hacen compras y contabilidad"/>
      <property key="disparador" value="Alerta de 6 meses"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S19 - Dar de baja un lote con acta aprobada" id="id-56764b65beed4716b8f393843bd8bc18">
      <documentation>Contrato del servicio S19 (Dar de baja un lote con acta aprobada), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="Contabilidad (vía A5)"/>
      <property key="proveedor" value="Control de la vida útil de los lotes (regente elabora, químico aprueba)"/>
      <property key="entrada" value="Lote vencido o deteriorado; acta de baja"/>
      <property key="salida" value="Lote dado de baja; aviso a contabilidad por A5"/>
      <property key="precondiciones" value="El lote está vencido o retenido"/>
      <property key="reglas" value="Nada se da de baja sin acta aprobada. Quien elabora el acta no la aprueba"/>
      <property key="disparador" value="Lote vencido, o decisión tras una retención"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato A1 - Recibir la agenda quirúrgica" id="id-90024ebc80654ee3afdc3bce0e5122ac">
      <documentation>Contrato del servicio A1 (Recibir la agenda quirúrgica), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="S01, S12"/>
      <property key="proveedor" value="Capa anticorrupción (C5)"/>
      <property key="entrada" value="Agenda quirúrgica (E1): cirugías programadas, canceladas y reprogramadas con código de procedimiento y fecha"/>
      <property key="salida" value="Cirugías programadas en el lenguaje de farmacia, con su paquete"/>
      <property key="precondiciones" value="Tabla procedimiento → paquete cargada"/>
      <property key="reglas" value="Traduce el procedimiento al paquete por cirugía. Una cancelación libera lo apartado (S12). No modifica la agenda"/>
      <property key="disparador" value="Publicación o cambio de la agenda"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato A2 - Recibir los movimientos del sistema hospitalario" id="id-99c41afd6fdd429994c8a15bf6c070f1">
      <documentation>Contrato del servicio A2 (Recibir los movimientos del sistema hospitalario), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="S02, S13, S14"/>
      <property key="proveedor" value="Capa anticorrupción (C5)"/>
      <property key="entrada" value="Salidas dispensadas, devoluciones y consumos de urgencias con código externo (E2)"/>
      <property key="salida" value="Movimientos de inventario con código interno"/>
      <property key="precondiciones" value="Códigos homologados (A7)"/>
      <property key="reglas" value="El sistema hospitalario no se modifica: se leen sus reportes o el paso nocturno. Un movimiento sin homologación se rechaza y se avisa"/>
      <property key="disparador" value="Paso nocturno o reporte del sistema hospitalario"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato A3 - Enviar el requerimiento y consultar lo que viene en camino" id="id-9b15384116854ad3aef6dd78f82e3238">
      <documentation>Contrato del servicio A3 (Enviar el requerimiento y consultar lo que viene en camino), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="S05, S06"/>
      <property key="proveedor" value="Capa anticorrupción (C5)"/>
      <property key="entrada" value="Requerimiento aprobado (S06); órdenes en camino de compras (E3)"/>
      <property key="salida" value="Requerimiento en el formato de compras; cantidades en camino por medicamento"/>
      <property key="precondiciones" value="Requerimiento aprobado, para el envío"/>
      <property key="reglas" value="Farmacia dice qué y cuánto; compras dice a quién y a qué precio. No se emiten órdenes de compra"/>
      <property key="disparador" value="Requerimiento aprobado, o cálculo del requerimiento neto"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato A4 - Intercambiar información con el proveedor" id="id-8bd1426a933343068987a0ebb05d1482">
      <documentation>Contrato del servicio A4 (Intercambiar información con el proveedor), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="S07, S18"/>
      <property key="proveedor" value="Capa anticorrupción (C5)"/>
      <property key="entrada" value="Remisión del proveedor con lote y vencimiento (E4); solicitud de canje (S18)"/>
      <property key="salida" value="Datos de recepción del lote; solicitud enviada al proveedor"/>
      <property key="precondiciones" value="Pedido esperado, o alerta de 6 meses"/>
      <property key="reglas" value="Lote y vencimiento son obligatorios en la recepción. Del canje solo se envía la solicitud"/>
      <property key="disparador" value="Llegada del pedido, o solicitud de canje"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato A5 - Reportar las bajas a contabilidad" id="id-858e0a83350d4d7d81d0857749bbbc1f">
      <documentation>Contrato del servicio A5 (Reportar las bajas a contabilidad), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="S19"/>
      <property key="proveedor" value="Capa anticorrupción (C5)"/>
      <property key="entrada" value="Baja aprobada: acta, lote y valor (S19)"/>
      <property key="salida" value="Reporte de baja para el sistema contable (E5)"/>
      <property key="precondiciones" value="Acta de baja aprobada"/>
      <property key="reglas" value="No se reporta una baja sin acta aprobada. El sistema contable no se modifica"/>
      <property key="disparador" value="Baja aprobada"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato A6 - Recibir alertas y retiros del INVIMA" id="id-ff46ea823ddf45d18bae08ba0ff1b763">
      <documentation>Contrato del servicio A6 (Recibir alertas y retiros del INVIMA), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="S17"/>
      <property key="proveedor" value="Capa anticorrupción (C5)"/>
      <property key="entrada" value="Alerta sanitaria o lote retirado publicado por el INVIMA (E6)"/>
      <property key="salida" value="Orden de retener el lote (S17)"/>
      <property key="precondiciones" value="Ninguna"/>
      <property key="reglas" value="El canal puede ser manual: el químico consulta la página del INVIMA y registra la alerta"/>
      <property key="disparador" value="Publicación del INVIMA"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato A7 - Homologar el código del medicamento" id="id-920c94841e584f9a865dfda787d2f9ed">
      <documentation>Contrato del servicio A7 (Homologar el código del medicamento), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="A1 a A6, S07, S10"/>
      <property key="proveedor" value="Capa anticorrupción (C5)"/>
      <property key="entrada" value="Código externo o código del empaque (E7) y sistema de origen"/>
      <property key="salida" value="Código interno del medicamento"/>
      <property key="precondiciones" value="Tabla de homologación cargada"/>
      <property key="reglas" value="Si no hay equivalencia se rechaza y se avisa; nunca se inventa un código"/>
      <property key="disparador" value="Cada mensaje que entra o sale de la capa anticorrupción"/>
    </element>
    <element xsi:type="archimate:Contract" name="Contrato S20 - Consultar los indicadores de vencimiento" id="id-478b0689e0a8487c94932581e31a7587">
      <documentation>Contrato del servicio S20 (Consultar los indicadores de vencimiento), diseñado antes de construirlo (Contract First).</documentation>
      <property key="consumidor" value="Químico farmacéutico; gerencia y dirección financiera"/>
      <property key="proveedor" value="Control de la vida útil de los lotes (automático)"/>
      <property key="entrada" value="Movimientos de inventario con lote; alertas de vencimiento; bajas aprobadas (actas)"/>
      <property key="salida" value="% de salidas con lote; % de lo alertado usado antes de vencer; valor dado de baja por vencimiento en el periodo"/>
      <property key="precondiciones" value="Ninguna"/>
      <property key="reglas" value="Solo lectura. Las fórmulas siguen los resultados de la V1. El % de vencidos sobre compras lo calcula financiera con este valor y el valor de compras del periodo"/>
      <property key="disparador" value="Consulta del usuario o cierre mensual"/>
    </element>
    <element xsi:type="archimate:Representation" name="Lote" id="id-de7a29b8aad54b7cad6fde57df10f1a7">
      <documentation>Unidades fabricadas en una misma tanda, con el mismo número y la misma fecha de vencimiento, asignados por el fabricante. Es la unidad de control de la aplicación. Ejemplo: ceftriaxona 1 g, lote A2345, vence 03/2027. Otro significado: en compras, grupo de ítems de una licitación (ver V7.1).</documentation>
      <property key="dominio" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Representation" name="Recepción técnica" id="id-ccb0f2957ead4bc2aba231679e006df1">
      <documentation>Revisión de lote, vencimiento, registro sanitario, estado y temperatura de lo recibido; deja el lote en cuarentena hasta aprobarlo, y quien la registra no la aprueba. No es la recepción administrativa, que compara contra orden y factura y la hace almacén. Ejemplo: un regente registra el lote y otro lo aprueba.</documentation>
      <property key="dominio" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Representation" name="Alerta" id="id-91a05ac72e66487288a072ab9b68e949">
      <documentation>En nuestro modelo: aviso de que un lote vence en 6, 3 o 1 mes. No es un estado: el lote sigue disponible y gana prioridad de salida. Ejemplo: alerta a 6 meses para gestionar el canje. Otros significados en V7.1 (alerta sanitaria del INVIMA).</documentation>
      <property key="dominio" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Representation" name="Canje" id="id-72962bdbe7614f6fb3989a54b5f74dd3">
      <documentation>Cambio con el proveedor de un lote próximo a vencer por el mismo producto con vencimiento más largo. Farmacia hace la solicitud técnica; compras negocia. No es la devolución al proveedor, que es contra nota crédito. Ejemplo: canje pedido con 6 meses de anticipación.</documentation>
      <property key="dominio" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Representation" name="Baja" id="id-cc6aeb8a001f46cda66c4e9bd160028b">
      <documentation>Retiro definitivo de un lote del inventario por vencimiento, avería o desperdicio, con acta aprobada; quien elabora el acta no la aprueba. No es cualquier descargue. Ejemplo: baja de 20 ampollas vencidas con acta. Otros significados en V7.1 (registro contable del gasto).</documentation>
      <property key="dominio" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Representation" name="Ubicación" id="id-989271dec7514be49e43067c752bde60">
      <documentation>Lugar físico con existencias: farmacia central (bodega principal), satélite (farmacia pequeña dentro de un servicio), stock de piso (cantidad fija a cargo de enfermería) o carro de paro. Se trata como una sola farmacia con varias ubicaciones.</documentation>
      <property key="dominio" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Representation" name="Estado del lote" id="id-4cec7ec5da88486493ff118210077dc5">
      <documentation>Situación de las existencias de un lote en una ubicación: cuarentena, disponible, apartado, retenido, vencido o dado de baja. 'Próximo a vencer' no es un estado: es una alerta y el lote sigue disponible con prioridad de salida. Un lote puede tener unidades en distintos estados según la ubicación; vencido y retirado por el INVIMA aplican al lote completo. Ejemplo: 40 ampollas disponibles en la central y 10 apartadas en cirugía.</documentation>
      <property key="dominio" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Representation" name="Apartado" id="id-52e0f58eb3834bb1aa7e40e5cd60b73a">
      <documentation>Estado de las unidades de un lote separadas físicamente para una cirugía; solo salen para esa cirugía y se liberan si se cancela. Se dice 'apartado' y no 'reservado' porque en cirugía 'reserva' es el quirófano o la cama (ver V7.1). Ejemplo: 10 viales apartados para la cirugía del martes.</documentation>
      <property key="dominio" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Representation" name="Cuarentena" id="id-12a6d9653a0b41f0b714ce561b6c207f">
      <documentation>Estado de un lote recibido que todavía no se puede usar porque espera la aprobación de la recepción técnica. Ejemplo: lote recibido hoy, pendiente de revisión.</documentation>
      <property key="dominio" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Representation" name="Retenido" id="id-08895502f1124687a2c0b1d498ee1dd4">
      <documentation>Estado de un lote bloqueado por alerta sanitaria, sospecha de calidad, falla de nevera, rechazo en la recepción o deterioro en una devolución. No sale hasta que un químico lo libera con soporte. Ejemplo: lote retenido en todas sus ubicaciones por un retiro del INVIMA.</documentation>
      <property key="dominio" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Representation" name="Vencido" id="id-1cdc238104cc4eb887e0d287fc26ff64">
      <documentation>Estado de un lote que pasó su fecha de vencimiento; aplica al lote completo, esté donde esté, y nunca sale. Ejemplo: lote con fecha 30/09/2026 el 1/10/2026. Otro significado: factura vencida en contabilidad (ver V7.1).</documentation>
      <property key="dominio" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Representation" name="Despachar" id="id-41530015a95647e5bdf2a177037ee8c6">
      <documentation>Mover medicamento de la central a una satélite o a un stock de piso, sin paciente asociado. No es consumo: sigue siendo inventario del hospital. Sinónimo: distribuir. No es dispensar ni administrar. Ejemplo: reposición del stock de piso de cirugía.</documentation>
      <property key="dominio" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Representation" name="Devolución" id="id-67c405e5923f4ee4b0a3bea165d1bc6d">
      <documentation>En nuestro modelo: el servicio devuelve a la farmacia unidades dispensadas y no administradas; reingresan a su mismo lote si el empaque está íntegro, o quedan retenidas si llegan deterioradas. Ejemplo: alta del paciente con 3 ampollas sin usar. Otros significados en V7.1 (al proveedor, nota crédito).</documentation>
      <property key="dominio" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Representation" name="FEFO" id="id-94e59d756774435aab5b3a46939517ad">
      <documentation>Primero en vencer, primero en salir: la salida se descuenta del lote que vence primero. Ejemplo: de dos lotes disponibles sale el que vence en marzo antes que el de junio.</documentation>
      <property key="dominio" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Representation" name="Requerimiento de compra" id="id-f7c64978f28442409b5a7f18edef4a37">
      <documentation>Lo que farmacia necesita comprar: qué y cuánto, aprobado por el químico farmacéutico. No es la orden de compra, que la emite compras al proveedor. Ejemplo: requerimiento ordinario mensual.</documentation>
      <property key="dominio" value="Planeación de la demanda"/>
    </element>
    <element xsi:type="archimate:Representation" name="Paquete" id="id-6995d02c225148048eac1bacc4f43ed1">
      <documentation>Medicamentos y cantidades estándar que se alistan para un tipo de cirugía (unos 180 paquetes). Sinónimo: canasta. Otro significado: en facturación, tarifa integral pactada con el asegurador (fuera del alcance).</documentation>
      <property key="dominio" value="Planeación de la demanda"/>
    </element>
    <element xsi:type="archimate:Representation" name="Consumo" id="id-6d3fdfa620a1432193a59f1c3b9f20c0">
      <documentation>En nuestro modelo: lo dispensado, es decir, lo que salió con lote hacia un paciente. No es lo despachado a las satélites, que hoy infla la cifra. Con esta cifra se calcula el requerimiento (S05). Decisión del equipo del 2026-10-12. Otros significados en V7.1.</documentation>
      <property key="dominio" value="Planeación de la demanda"/>
    </element>
    <element xsi:type="archimate:Representation" name="Pedido" id="id-02cf8c25510541df973fba6954e3ea48">
      <documentation>Término que NO se usa en el modelo por ambiguo: se dice requerimiento de compra (de farmacia a compras), orden de compra (de compras al proveedor) o despacho (de la central a una satélite). Es una de las tres confusiones que más problemas causan. Significados en V7.1.</documentation>
      <property key="dominio" value="Planeación de la demanda"/>
    </element>
    <element xsi:type="archimate:Representation" name="Referencia" id="id-b0ecbea3ff33410d966da50746e43338">
      <documentation>Principio activo más concentración y forma farmacéutica; es lo que tiene código interno (unas 1.150). No es el producto comercial (de un laboratorio, con registro sanitario y CUM) ni la presentación (el empaque). Ejemplo: ceftriaxona 1 g polvo para inyección.</documentation>
      <property key="dominio" value="Catálogo de medicamentos"/>
    </element>
    <element xsi:type="archimate:Representation" name="Dispensar" id="id-e06edd23efc94f458630cd202642bfc9">
      <documentation>Entregar el medicamento contra una prescripción, a un paciente identificado, con verificación de quien entrega. Es un acto de farmacia que se registra en el sistema hospitalario; nuestro software recibe la salida y la descuenta del lote. No es despachar ni administrar.</documentation>
      <property key="dominio" value="Otro contexto: sistema hospitalario"/>
    </element>
    <element xsi:type="archimate:Representation" name="Administrar" id="id-492aa774c2c8425bb93ff1d7b6681403">
      <documentation>Aplicarle o darle el medicamento al paciente. Lo hace enfermería o anestesiología y queda en la historia clínica; no es de farmacia. La diferencia entre lo dispensado y lo administrado es la devolución.</documentation>
      <property key="dominio" value="Otro contexto: enfermería"/>
    </element>
    <element xsi:type="archimate:Representation" name="Orden" id="id-372726278183492788066dbcd6be7037">
      <documentation>En nuestro modelo: orden de compra, que emite compras al proveedor. En el sistema hospitalario, 'orden' es la orden médica (ver V7.1).</documentation>
      <property key="dominio" value="Otro contexto: compras"/>
    </element>
    <element xsi:type="archimate:Representation" name="Producto comercial" id="id-111c0bac9eef4a379024821e51bd7436">
      <documentation>Una referencia fabricada por un laboratorio concreto, con su registro sanitario y su CUM. Una misma referencia puede tener varios productos comerciales; el CUM es uno de los códigos externos que se homologan al código interno (A7). Ejemplo: ceftriaxona 1 g del laboratorio X, con su registro INVIMA.</documentation>
      <property key="dominio" value="Catálogo de medicamentos"/>
    </element>
    <element xsi:type="archimate:Representation" name="Presentación" id="id-465394d825134ba6be9607449276bf50">
      <documentation>Cómo viene empacado el producto. Ejemplo: caja por 1 vial o caja por 50. Ojo: algunos le dicen también presentación a la forma farmacéutica (tableta, ampolla, jarabe); en el modelo es solo el empaque.</documentation>
      <property key="dominio" value="Catálogo de medicamentos"/>
    </element>
    <element xsi:type="archimate:Representation" name="Unidad mínima" id="id-aac3ee4f6b8a4a5f8b56331b7d10b900">
      <documentation>El vial, la ampolla o la tableta. Es la unidad en la que se cuentan las existencias de cada lote. Ejemplo: una caja por 50 ampollas son 50 unidades mínimas.</documentation>
      <property key="dominio" value="Catálogo de medicamentos"/>
    </element>
  </folder>
  <folder name="Application" id="id-becbf05975364aa3817ab9c05e2723cb" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Control de lotes y vencimientos" id="id-745680784cdc415aaf8572fb9a8b7bc8">
      <documentation>Dominio central. Saber qué lote hay, cuánto, dónde y cuándo vence, y actuar antes de que venza: recepción técnica y cuarentena, existencias por lote y ubicación, traslados, apartado para cirugía, salida del lote que vence primero, devoluciones, alertas a 6, 3 y 1 mes, retención, canje, baja con acta e indicadores. Argumentos: es la causa de fondo del problema ($310 M al año en vencidos) y, según el experto, todo lo demás depende de eso; el sistema hospitalario dispensa sin lote y no se puede modificar; es el único dueño del agregado Lote, cuyos invariantes (nada sale sin recepción técnica, nunca sale un vencido ni un retenido, existencias nunca negativas) quedan en un solo dominio. La recepción técnica va aquí porque crea el lote y lo deja en cuarentena.</documentation>
      <property key="tipo_dominio" value="central"/>
      <property key="fase" value="3"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Planeación de la demanda" id="id-621a3d71508c4c27bf7ba7a9db651b24">
      <documentation>Dominio de soporte. Predicción de la demanda programada (paquetes por cirugía x agenda) y no programada (histórico de urgencias), y requerimiento de compra neto. Argumentos: es específico del hospital (paquetes por cirugía, requerimiento que descuenta lo que se va a vencer), por eso no es genérico; pero el equipo lo simplificó a propósito, por eso no es central. Consume del dominio central las existencias y lo que se va a vencer.</documentation>
      <property key="tipo_dominio" value="soporte"/>
      <property key="fase" value="3"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Catálogo de medicamentos" id="id-4922d1a8d3c14415b5b9e6ed5218b31d">
      <documentation>Dominio genérico. Maestro de medicamentos con un código interno. Argumento: es un problema resuelto que tiene cualquier sistema de inventario. La traducción de los códigos externos (A7) se trata en la Fase 5 como capa anticorrupción.</documentation>
      <property key="tipo_dominio" value="genérico"/>
      <property key="fase" value="3"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Usuarios, roles y permisos" id="id-107e297b77d541c1b9a10fc70ea18fa9">
      <documentation>Dominio genérico. Quién es quién y qué puede aprobar. Soporta la regla de separación de funciones (quien registra no aprueba) que usan las aprobaciones de los dominios central y de soporte. Argumento: es un mecanismo estándar, no propio de la farmacia; no realiza servicios de tarea propios.</documentation>
      <property key="tipo_dominio" value="genérico"/>
      <property key="fase" value="3"/>
    </element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-ae3d0119d4c14a0abd294199b644587d" type="technology">
    <element xsi:type="archimate:TechnologyService" name="Lectura del código de barras del empaque" id="id-521d465fdf96466386e5af802693bc5d">
      <documentation>Dispositivo. Entrega el código impreso en el empaque al recibir y al trasladar.</documentation>
      <property key="codigo" value="E7"/>
      <property key="capa" value="C5"/>
      <property key="alcance" value="externo"/>
    </element>
    <element xsi:type="archimate:Device" name="Lector de código de barras" id="id-ef52641f719d410da0964b630f9bb2c2">
      <documentation>Dispositivo de captura usado en la recepción técnica y en los traslados.</documentation>
    </element>
  </folder>
  <folder name="Motivation" id="id-4f908b051e6649b2bcea2367578c8d34" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Servicio farmacéutico" id="id-b3a3b8a785014acf895aaef54b3afeaf"/>
    <element xsi:type="archimate:Stakeholder" name="Gerencia y dirección financiera" id="id-0f996783eb0a4fa2a61e9fd31259ce21"/>
    <element xsi:type="archimate:Stakeholder" name="Médicos" id="id-ef362bbf4d5645949094fdd46a7e3156"/>
    <element xsi:type="archimate:Stakeholder" name="Enfermería" id="id-a98ed3fbc6d846e693226f8b9ad43e66"/>
    <element xsi:type="archimate:Stakeholder" name="Compras" id="id-c6a8230e9a8842cab3081d429da3a726"/>
    <element xsi:type="archimate:Driver" name="Pérdida creciente por vencimientos ($190 M → $310 M en dos años)" id="id-6b33e2311048477490fc2e2312832429"/>
    <element xsi:type="archimate:Driver" name="Hallazgo de la Secretaría de Salud: vencidos en carro de paro" id="id-117b065d78924777849376fe91acefee"/>
    <element xsi:type="archimate:Driver" name="Presión de caja por cartera con las EPS" id="id-245b62b0d1eb48199203acbbbe5d7504"/>
    <element xsi:type="archimate:Driver" name="Acreditación en salud" id="id-880c1ed90acb44be8e52de9e7a00b5e5"/>
    <element xsi:type="archimate:Assessment" name="Las salidas no registran de qué lote salen (causa raíz)" id="id-cd4225ebee4a4d40a2783bb75b3a1a58"/>
    <element xsi:type="archimate:Assessment" name="Se compra con promedios y hay sobrestock (40 % de vencidos)" id="id-ad56b35b619e467aab396d0b8b1cb841"/>
    <element xsi:type="archimate:Assessment" name="Producto quieto en los servicios (25 % de vencidos)" id="id-97bb2164ae764e38bc3ba0460a6b197c"/>
    <element xsi:type="archimate:Assessment" name="Llega producto con poca vida útil (20 % de vencidos)" id="id-152ca1c49159418db5770e39a8c9be46"/>
    <element xsi:type="archimate:Assessment" name="Cambios de protocolo dejan producto sin uso (15 % de vencidos)" id="id-3bb04fc401c948748ef69ba0e1e7620e"/>
    <element xsi:type="archimate:Assessment" name="Agotados y compras urgentes" id="id-d1756cc76d054db4aa9b68deffd897d9"/>
    <element xsi:type="archimate:Goal" name="Garantizar la disponibilidad de medicamentos y reducir los vencidos a menos del 0,4 % de las compras en 12 meses" id="id-3b2117836e0d4e56b63f537920174a0c"/>
    <element xsi:type="archimate:Outcome" name="Vencidos ≤ 0,4 % de las compras" id="id-9a598731bd754e0496251701a1bd2479"/>
    <element xsi:type="archimate:Outcome" name="100 % de las salidas con lote" id="id-a6e5877ca36e41c49a46b36a3c69176a"/>
    <element xsi:type="archimate:Outcome" name="≥ 80 % de los lotes en alerta usados antes de vencer" id="id-114a7a16ce1d44948f3d5741e3a3043e"/>
    <element xsi:type="archimate:Outcome" name="Máximo 6 compras urgentes al mes" id="id-67fa7f68a3cf463f98fb00cb9d6c24f4"/>
    <element xsi:type="archimate:Principle" name="La seguridad del paciente va primero" id="id-d574b0ca99834f76ae73497a4b8a85de"/>
    <element xsi:type="archimate:Principle" name="La disponibilidad pesa más que el ahorro" id="id-561c2573cbd14f0bbba51e39cac1a560"/>
    <element xsi:type="archimate:Principle" name="Sale primero lo que vence primero" id="id-b162f4774dd140769b0064366f7bba7a"/>
    <element xsi:type="archimate:Principle" name="El sistema recomienda y la persona decide" id="id-86d8296220e94bc5b2aae9012f6b5e63"/>
    <element xsi:type="archimate:Requirement" name="Controlar el inventario por lote, ubicación y fecha de vencimiento" id="id-91b8a499b3714819b35b2145218ed89e"/>
    <element xsi:type="archimate:Requirement" name="Alertar a 6, 3 y 1 mes del vencimiento y priorizar el uso de esos lotes" id="id-92d2ef930f9d407dbbae903a85586dff"/>
    <element xsi:type="archimate:Requirement" name="Predecir la demanda programada (agenda × paquetes por cirugía) y no programada (histórico de urgencias)" id="id-686ec702ab344ea982fe74ae90899156"/>
    <element xsi:type="archimate:Requirement" name="Generar requerimientos de compra descontando lo que vencerá antes de usarse" id="id-a4e1175e6ab9427295274d6d2fa6cea3"/>
    <element xsi:type="archimate:Constraint" name="Sin personal adicional" id="id-ec0c4177fb3c4e06aefa33471ac87504"/>
    <element xsi:type="archimate:Constraint" name="Los sistemas hospitalario y contable no se pueden modificar" id="id-c2f2cad6fa124c08848b13547fa7a264"/>
    <element xsi:type="archimate:Meaning" name="Control de lotes: reposición de una satélite a la central" id="id-1c3dff5635c94f6c8ff48516aaf2f04c">
      <documentation>Lo que una satélite le pide a la central. En el modelo se dice despacho o reposición, no pedido.</documentation>
      <property key="termino" value="Pedido"/>
      <property key="contexto" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Planeación: requerimiento a compras" id="id-0a58e124d0f84690a81691144f4423ed">
      <documentation>Lo que farmacia le pide a compras. En el modelo se dice requerimiento de compra, no pedido.</documentation>
      <property key="termino" value="Pedido"/>
      <property key="contexto" value="Planeación de la demanda"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Compras: orden al proveedor" id="id-6c34963f58534b4c8b8a9747ee542847">
      <documentation>Para compras, el pedido es la orden de compra al proveedor. Es la confusión que más problemas causa: farmacia cree que ya pidió y compras todavía no ha emitido la orden.</documentation>
      <property key="termino" value="Pedido"/>
      <property key="contexto" value="Gestión de compras (E3)"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Planeación: lo dispensado (definición del modelo)" id="id-00bac27badef4f9cb3f8cbb78286638f">
      <documentation>Lo que salió con lote hacia un paciente. Es la cifra con la que se calcula el requerimiento (S05). Decisión del equipo del 2026-10-12.</documentation>
      <property key="termino" value="Consumo"/>
      <property key="contexto" value="Planeación de la demanda"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Control de lotes: lo despachado a las satélites" id="id-7f38a36e36044f469397d8a8730a0471">
      <documentation>Lo que hoy la central llama consumo: las salidas hacia las satélites. Infla la cifra porque incluye lo que se queda quieto o se devuelve. En el modelo no es consumo sino despacho.</documentation>
      <property key="termino" value="Consumo"/>
      <property key="contexto" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Contabilidad: lo cargado al costo" id="id-63ba1e7ff593413d827d995729ffc75b">
      <documentation>Consumo por centro de costo en el sistema contable.</documentation>
      <property key="termino" value="Consumo"/>
      <property key="contexto" value="Registro contable (E5)"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Control de lotes: del servicio a la farmacia" id="id-29ebf3450c7249b3ae4b9d23cda9bb2a">
      <documentation>Lo dispensado y no administrado que vuelve a la farmacia; reingresa a su mismo lote. Es el significado del modelo.</documentation>
      <property key="termino" value="Devolución"/>
      <property key="contexto" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Proveedor: de la farmacia al proveedor" id="id-1266addcf0bf4e76a3b1308a27e74617">
      <documentation>Lo que sale de la farmacia hacia el proveedor contra nota crédito. No es canje.</documentation>
      <property key="termino" value="Devolución"/>
      <property key="contexto" value="Suministro de medicamentos (E4)"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Contabilidad: nota crédito" id="id-58a04fc78edf4dec99072639858db77f">
      <documentation>Registro contable del valor que reconoce el proveedor por lo devuelto.</documentation>
      <property key="termino" value="Devolución"/>
      <property key="contexto" value="Registro contable (E5)"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Control de lotes: retiro con acta" id="id-ead08d9f59824e6da9d53bf0eef93837">
      <documentation>Retiro definitivo del lote por vencimiento, avería o desperdicio, con acta aprobada. Es el significado del modelo.</documentation>
      <property key="termino" value="Baja"/>
      <property key="contexto" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Contabilidad: registro del gasto" id="id-5cae80bcfbe2417096810fb48bdd24ca">
      <documentation>Registro del gasto de lo dado de baja, a veces semanas después del acta.</documentation>
      <property key="termino" value="Baja"/>
      <property key="contexto" value="Registro contable (E5)"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Control de lotes: alerta de vencimiento" id="id-c6134161a60c44d28623532506a40797">
      <documentation>Aviso a 6, 3 o 1 mes del vencimiento; el lote sigue disponible con prioridad de salida. Es el significado del modelo.</documentation>
      <property key="termino" value="Alerta"/>
      <property key="contexto" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Meaning" name="INVIMA: alerta sanitaria" id="id-2e72917088fe4965bfcc1f3237f094f6">
      <documentation>Alerta o retiro de un lote publicado por el INVIMA; el lote se retiene en todas sus ubicaciones.</documentation>
      <property key="termino" value="Alerta"/>
      <property key="contexto" value="Alertas sanitarias y retiros de lotes (E6)"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Control de lotes: lote de fabricación" id="id-846f60a42db54d18b87d96291b359b54">
      <documentation>Unidades de una misma tanda con el mismo número y fecha de vencimiento. Es el significado del modelo.</documentation>
      <property key="termino" value="Lote"/>
      <property key="contexto" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Compras: grupo de ítems de una licitación" id="id-13df953e999647b398df26869b5682e9">
      <documentation>Para compras, un lote es un grupo de ítems que se licitan juntos.</documentation>
      <property key="termino" value="Lote"/>
      <property key="contexto" value="Gestión de compras (E3)"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Compras: orden de compra" id="id-07202e551b3243519cee900d89a205d5">
      <documentation>Documento que compras emite al proveedor. Es el significado del modelo.</documentation>
      <property key="termino" value="Orden"/>
      <property key="contexto" value="Gestión de compras (E3)"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Sistema hospitalario: orden médica" id="id-e436337afb4141ac8c71685aff810101">
      <documentation>Prescripción del médico en hospitalización.</documentation>
      <property key="termino" value="Orden"/>
      <property key="contexto" value="Registro de dispensación y consumos (E2)"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Control de lotes: unidades apartadas para una cirugía" id="id-af305fc06e6049baa0be54b235f993c8">
      <documentation>Unidades de un lote separadas para una cirugía; solo salen para ella. Es el significado del modelo.</documentation>
      <property key="termino" value="Apartado"/>
      <property key="contexto" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Programación quirúrgica: reserva de quirófano o cama" id="id-6f2303f2a82849dbaa4bcfc1e9015643">
      <documentation>En cirugía, 'reserva' es el quirófano o la cama de UCI separada. Por eso el modelo dice 'apartado' y no 'reservado'.</documentation>
      <property key="termino" value="Apartado"/>
      <property key="contexto" value="Programación quirúrgica (E1)"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Control de lotes: lote que pasó su fecha" id="id-7d47840a0bfb47e1a298e47939b96590">
      <documentation>Lote que pasó su fecha de vencimiento; nunca sale. Es el significado del modelo.</documentation>
      <property key="termino" value="Vencido"/>
      <property key="contexto" value="Control de lotes y vencimientos"/>
    </element>
    <element xsi:type="archimate:Meaning" name="Contabilidad: factura vencida" id="id-ce1d87f42bf84a95831105bfa9280d0b">
      <documentation>Factura que pasó su plazo de pago (cartera y contabilidad).</documentation>
      <property key="termino" value="Vencido"/>
      <property key="contexto" value="Registro contable (E5)"/>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-4ed897f9fc244910bf5cebd9f13453b2" type="implementation_migration"/>
  <folder name="Other" id="id-11bbf2782c3244899d77a8443d64e3a7" type="other">
    <element xsi:type="archimate:Grouping" name="Procesos estratégicos" id="id-1aaca38a922d409bb8548d01c02e90fd">
      <documentation>Macroproceso del mapa de procesos del hospital.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Procesos misionales" id="id-c8b744e951de479e8697c052befbdf47">
      <documentation>Macroproceso del mapa de procesos del hospital.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Apoyo diagnóstico y terapéutico" id="id-863a9d951ed549f29d588495a01fb2b3">
      <documentation>Macroproceso del mapa de procesos del hospital donde se ubica la farmacia.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Apoyo administrativo" id="id-9225cfe79cc04034af1858db85086e0f">
      <documentation>Macroproceso del mapa de procesos del hospital.</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="C1 - Servicio E2E" id="id-ec62898e0d1240a595cf938dc8dd3201">
      <documentation>Servicio que presta el proceso E2E completo.</documentation>
      <property key="capa_soa" value="Proceso de negocio"/>
    </element>
    <element xsi:type="archimate:Grouping" name="C2 - Servicios de ciclo" id="id-9cabbd55895e42a8a575a53154dfda98">
      <documentation>Un servicio por ciclo del proceso E2E (V3) más la vigilancia en paralelo.</documentation>
      <property key="capa_soa" value="Subproceso / orquestación"/>
    </element>
    <element xsi:type="archimate:Grouping" name="C3 - Servicios de actividad" id="id-d2d0e5b1180c4ff3926d8f6dfa108611">
      <documentation>Un servicio por cada proceso de la V3.</documentation>
      <property key="capa_soa" value="Servicio de negocio"/>
    </element>
    <element xsi:type="archimate:Grouping" name="C4 - Servicios de tarea" id="id-1d218576f2434a14af9d70ede716833b">
      <documentation>Servicios del tamaño de una tarea: sobre ellos se construye la aplicación.</documentation>
      <property key="capa_soa" value="Tarea"/>
    </element>
    <element xsi:type="archimate:Grouping" name="C5 - Capa anticorrupción (interoperabilidad)" id="id-df58c8f1a05049c4b056f422d09265f1">
      <documentation>Servicios externos y servicios propios que traducen. La capa anticorrupción propiamente dicha son los servicios propios A1–A7, que traducen y homologan; E1–E7 son los servicios externos con los que se intercambia información y se muestran aquí para ver qué entra y qué sale. Los sistemas hospitalario y contable no se pueden modificar y cada sistema usa un código distinto de medicamento.</documentation>
      <property key="capa_soa" value="Utilitario / integración"/>
    </element>
    <element xsi:type="archimate:Grouping" name="Dominio central" id="id-a82b60c7e4ae40639153d1902ff23c64">
      <documentation>Clasificación DDD: el dominio que diferencia al hospital y por el que existe la aplicación (Fase 3).</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Dominio de soporte" id="id-388f8c3b57544562a0a804fd7e37854d">
      <documentation>Clasificación DDD: específico del hospital y necesario, pero no es lo que lo diferencia (Fase 3).</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Dominios genéricos" id="id-1963bb8de43a4757a583f69161bf3f81">
      <documentation>Clasificación DDD: problemas ya resueltos que cualquier sistema tiene (Fase 3).</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Lenguaje de Control de lotes y vencimientos" id="id-4f7228a84ea84045998d68b1c55104c1">
      <documentation>Términos del lenguaje ubicuo del dominio central (Fase 3).</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Lenguaje de Planeación de la demanda" id="id-85a3d5dc1dd24b39a6c8104c8409af74">
      <documentation>Términos del lenguaje ubicuo del dominio de soporte (Fase 3).</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Lenguaje de Catálogo de medicamentos" id="id-78642d84f32d423fa7a603cc2c3a9ad5">
      <documentation>Términos del lenguaje ubicuo del dominio genérico de catálogo (Fase 3).</documentation>
    </element>
    <element xsi:type="archimate:Grouping" name="Términos de otros contextos" id="id-b231a18a508e46a29c7bcb04870340b4">
      <documentation>Términos que no pertenecen a nuestros dominios pero que hay que distinguir de los nuestros (el experto pidió distinguir siempre dispensado de administrado y requerimiento de orden de compra).</documentation>
    </element>
  </folder>
